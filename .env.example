# Public frontend/tooling settings. Never place secrets in VITE_ variables.
# Defaults are owned by config/settings.ts and config/development.json; values here are examples.
VITE_DEV_HOST=127.0.0.1
VITE_DEV_PORT=5173
VITE_DEV_POLLING=false
VITE_DEV_POLL_INTERVAL_MS=1000
VITE_CORE_PROXY_TARGET=
VITE_LOCALE=en-US
VITE_TIMEZONE=America/New_York
VITE_SIMULATION_DELAY_MS=900
VITE_NOTIFICATION_MS=4500
VITE_MAX_UPLOAD_BYTES=65536
VITE_MAX_TEXT_LENGTH=400
VITE_ANIMATION_SECONDS=0.26

# Persistent core engine (safe examples; actual recovery stays private).
VB_MIGRATION_CONFIG=alembic.ini
VB_DATABASE_URL='postgresql+psycopg://test-user:test-password@127.0.0.1:15432/test-db'
VB_STAGE='local'
# Leave auth null for capability-only local development. Enable with nested settings.
VB_AUTH='null'
VB_OBSERVATION_FILE='config/observation-profiles.json'
# Safe OIDC examples. Use a dedicated web client, never the Calendar desktop client.
# VB_AUTH__DISCOVERY_URL='https://accounts.google.com/.well-known/openid-configuration'
# VB_AUTH__ISSUER='https://accounts.google.com'
# VB_AUTH__CLIENT_ID='not-yet-configured'
# VB_AUTH__CLIENT_SECRET='test-key'
